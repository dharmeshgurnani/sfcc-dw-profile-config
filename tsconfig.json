{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "es2022",
    "outDir": "out",
    "types": [
      "node"
    ],
    "lib": [
      "es2022"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "Node"
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "refrence"
  ],
  "include": [
    "src/**/*"
  ]
}
