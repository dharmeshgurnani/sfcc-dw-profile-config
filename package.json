{
  "name": "sfcc-dw-profile-config",
  "displayName": "SFCC DW Profile Config",
  "publisher": "dharmeshgurnani",
  "author": "Dharmesh Gurnani",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dharmeshgurnani/sfcc-dw-profile-config"
  },
  "bugs": {
    "url": "https://github.com/dharmeshgurnani/sfcc-dw-profile-config/issues"
  },
  "homepage": "https://github.com/dharmeshgurnani/sfcc-dw-profile-config#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/dharmeshgurnani"
  },
  "description": "Define multiple dw.json profiles and switch them easily using the status bar",
  "keywords": [
    "sfcc",
    "salesforce commerce cloud",
    "demandware",
    "dw.json",
    "b2c commerce",
    "sandbox"
  ],
  "version": "1.1.4",
  "license": "MIT",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run package-extension",
    "clean": "node scripts/clean-out.cjs",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package-extension": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "pretest": "npm run compile",
    "test": "node scripts/run-tests.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "dw-profiles.pickProfile",
        "title": "DW Profiles: Pick Profile"
      },
      {
        "command": "dw-profiles.createProfile",
        "title": "DW Profiles: Create Profile",
        "icon": "$(add)"
      },
      {
        "command": "dw-profiles.editProfile",
        "title": "DW Profiles: Edit Profile"
      },
      {
        "command": "dw-profiles.deleteProfile",
        "title": "DW Profiles: Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "dw-profiles.applyProfileNode",
        "title": "Apply Profile",
        "icon": "$(check)"
      },
      {
        "command": "dw-profiles.editProfileNode",
        "title": "Edit Profile",
        "icon": "$(edit)"
      },
      {
        "command": "dw-profiles.deleteProfileNode",
        "title": "Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "dw-profiles.refreshSidebar",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dw-profiles-container",
          "title": "DW Profiles",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dw-profiles-container": [
        {
          "id": "dw-profiles-view",
          "name": "Profiles",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dw-profiles.createProfile",
          "when": "view == dw-profiles-view",
          "group": "navigation"
        },
        {
          "command": "dw-profiles.refreshSidebar",
          "when": "view == dw-profiles-view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dw-profiles.applyProfileNode",
          "when": "view == dw-profiles-view && viewItem == dwProfile",
          "group": "inline"
        },
        {
          "command": "dw-profiles.editProfileNode",
          "when": "view == dw-profiles-view && viewItem == dwProfile",
          "group": "inline"
        },
        {
          "command": "dw-profiles.deleteProfileNode",
          "when": "view == dw-profiles-view && viewItem == dwProfile",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "DW Profiles",
      "properties": {
        "dwProfiles.profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "DW Profile",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the profile. E.g: Staging, Development"
              },
              "hostname": {
                "type": "string",
                "description": "SFCC Hostname"
              },
              "username": {
                "type": "string",
                "description": "SFCC Username"
              },
              "password": {
                "type": "string",
                "description": "SFCC Password or specific key"
              },
              "code-version": {
                "type": "string",
                "description": "SFCC Code Version"
              }
            }
          },
          "default": [],
          "description": "List of all DW profiles",
          "scope": "application"
        },
        "dwProfiles.workspaceProfileSelections": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "Stores the selected profile ID for each workspace folder."
        },
        "dwProfiles.statusBarFormat": {
          "type": "string",
          "enum": [
            "full",
            "compact"
          ],
          "default": "full",
          "markdownDescription": "Status bar display format:\n- **full**: `DW > profile` (default)\n- **compact**: `profile`"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.83.0",
    "esbuild": "^0.20.0",
    "typescript": "^7.0.2"
  }
}
